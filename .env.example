# Copiar a .env. Usar dos contraseñas largas, únicas y distintas.
# Las comillas simples conservan literalmente los caracteres $, # y espacios.
FACTURACION_DB_NAME=facturacion_db
FACTURACION_DB_USER=facturacion
FACTURACION_DB_PASS=''
MYSQL_ROOT_PASSWORD=''

# Acceso por http://IP-DEL-SERVIDOR:8080. Con proxy local, usar 127.0.0.1.
APP_BIND_IP=0.0.0.0
APP_PORT=8080
# Cambiar a 1 al publicar mediante HTTPS (también detrás de un proxy).
FACTURACION_COOKIE_SECURE=0

# Opcional. Sin credenciales SMTP los correos permanecen pendientes.
FACTURACION_SMTP_HOST=
FACTURACION_SMTP_PUERTO=465
FACTURACION_SMTP_CIFRADO=ssl
FACTURACION_SMTP_AUTH=LOGIN
FACTURACION_SMTP_USUARIO=
FACTURACION_SMTP_CLAVE=''
FACTURACION_CORREO_REMITENTE=
FACTURACION_CORREO_JEFE=
